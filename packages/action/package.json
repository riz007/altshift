{
  "name": "@ariamend/action",
  "version": "0.0.0",
  "description": "Ariamend GitHub Action entry. Internal: bundled into the ariamend package.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@ariamend/core": "workspace:*",
    "@ariamend/fix": "workspace:*",
    "@ariamend/github": "workspace:*",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  }
}
