# Copy to .env.local for local fix and eval runs. Never commit real keys.

# Phase A: bring your own key. Needed only for `ariamend fix` and evals.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults live in packages/fix/src/models.ts.
# ARIAMEND_MODEL_FIX=claude-fable-5-2
# ARIAMEND_MODEL_TRIAGE=claude-haiku-5-5
# ARIAMEND_MODEL_FALLBACK=claude-sonnet-5-5

# Phase B and later
# ARIAMEND_LICENSE_KEY=

# Local testing against GitHub
# GITHUB_TOKEN=
