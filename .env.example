# Copy to .env.local for local fix and eval runs. Never commit real keys.

# Phase A: bring your own key. Needed only for `altshift fix` and evals.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults live in packages/fix/src/models.ts.
# ALTSHIFT_MODEL_FIX=claude-fable-5-2
# ALTSHIFT_MODEL_TRIAGE=claude-haiku-5-5
# ALTSHIFT_MODEL_FALLBACK=claude-sonnet-5-5

# Phase B and later
# ALTSHIFT_LICENSE_KEY=

# Local testing against GitHub
# GITHUB_TOKEN=
